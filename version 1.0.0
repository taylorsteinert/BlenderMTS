class VertexGroupMuscleEnds(bpy.types.Operator):
    bl_idname = "object.define_muscle_ends"
    bl_label = "Define muscle ends"
    bl_description = "Create and auto-assign vertex group 'muscle ends'"

    def execute(self, context):
        obj = context.object
        if obj and obj.type == 'MESH':
            # Checks for presence of vertex group muscle_ends
            if "muscle_ends" not in obj.vertex_groups:
                # Creates new vg muscle_ends
                obj.vertex_groups.new(name="muscle_ends")
                # Auto-assigns vg muscle_ends cloth mod > shape > pin_group
                bpy.context.object.modifiers["Cloth"].settings.vertex_group_mass = "muscle_ends"
                self.report({'INFO'}, "muscle ends group created")
            else:
                self.report({'WARNING'}, "Vertex group already exists")
            return {'FINISHED'}
        else:
            self.report({'ERROR'}, "No mesh object selected")
            return {'CANCELLED'}

class VertexGroupMusclePressure(bpy.types.Operator):
    bl_idname = "object.define_muscle_pressure"
    bl_label = "Define muscle pressure"
    bl_description = "Create and auto-assign vertex group 'muscle_pressure'"

    def execute(self, context):
        obj = context.object
        if obj and obj.type == 'MESH':
            if "muscle_pressure" not in obj.vertex_groups:
                obj.vertex_groups.new(name="muscle_pressure")
                bpy.context.object.modifiers["Cloth"].settings.vertex_group_pressure = "muscle_pressure"
                self.report({'INFO'}, "Muscle weight group created")
            else:
                self.report({'WARNING'}, "Vertex group already exists")
            return {'FINISHED'}
        else:
            self.report({'ERROR'}, "No mesh object selected")
            return {'CANCELLED'}

