#simple blender physics based muscle simulation add-on that can be used in comb. with a rigged, animated creature mesh

bl_info = {
    "name": "Muscle Tissue Simulator",
    "author": "Taylor Steinert",
    "description": "Muscle Simulation Add-On",
    "version": (1, 0, 0),
    "blender": (4, 4, 3),
    "location": "3D Viewport > Sidebar",
    "category": "MTS",
}

import bpy
import bmesh

from bpy.types import Operator
from bpy.props import IntProperty
from bpy.props import FloatProperty, PointerProperty
from bpy.types import Panel, PropertyGroup, Operator

class PlayAnimationOperator(bpy.types.Operator):
    
    """Starts animation playback"""
    bl_idname = "screen.custom_play_animation"
    bl_label = "Play Animation"

    def execute(self, context):
        if not context.screen.is_animation_playing:
            bpy.ops.screen.animation_play()
            print("Animation is playing")
        return {'FINISHED'}

class PauseAnimationOperator(bpy.types.Operator):
    """Pauses animation playback"""
    bl_idname = "screen.custom_pause_animation"
    bl_label = "Pause Animation"

    def execute(self, context):
        if context.screen.is_animation_playing:
            bpy.ops.screen.animation_play()
            print("Animation is paused")
        return {'FINISHED'}


class EnablePhysicsOperator(bpy.types.Operator):
    """Adds a cloth modifier to the selected object(s)"""
    bl_idname = "object.enable_cloth_physics"
    bl_label = "Enable Cloth Physics"
    bl_options = {'REGISTER', 'UNDO'}


    def execute(self, context):
        for obj in context.selected_objects:
            if obj.type == 'MESH':
                # Check if cloth modifier already exists
                if not any(mod.type == 'CLOTH' for mod in obj.modifiers):
                    obj.modifiers.new(name="Cloth", type='CLOTH')
                    self.report({'INFO'}, f"Cloth modifier added to {obj.name}")
                    
                    # Defines obj
                    obj = bpy.context.object
                    
                    # Defines cloth settings
                    cloth_settings = obj.modifiers["Cloth"].settings
                    
                    cloth_settings.use_internal_springs = True
                    cloth_settings.use_pressure = True
              
                    # Adjusts internal spring properties
                    cloth_settings.internal_tension_stiffness = 2.0
                    cloth_settings.internal_compression_stiffness = 2.0
                    
                    cloth_settings.internal_tension_stiffness_max = 3.0
                    cloth_settings.internal_compression_stiffness_max = 3.0                  
                    
                    #Adjusts uniform pressure force properties
                    cloth_settings.uniform_pressure_force = 2.0
                else:
                    self.report({'WARNING'}, f"{obj.name} already has a cloth modifier")
            else:
                self.report({'WARNING'}, f"{obj.name} is not a mesh object")
        return {'FINISHED'}


class DisablePhysicsOperator(bpy.types.Operator):
    """Removes the cloth modifier from the selected object(s)"""
    bl_idname = "object.disable_cloth_physics"
    bl_label = "Disable Cloth Physics"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        for obj in context.selected_objects:
            if obj.type == 'MESH':
                # Collect cloth modifiers to remove
                cloth_mods = [mod for mod in obj.modifiers if mod.type == 'CLOTH']
                if cloth_mods:
                    for mod in cloth_mods:
                        obj.modifiers.remove(mod)
                    self.report({'INFO'}, f"Removed cloth modifier from {obj.name}")
                else:
                    self.report({'WARNING'}, f"No cloth modifier found on {obj.name}")
            else:
                self.report({'WARNING'}, f"{obj.name} is not a mesh object")
        return {'FINISHED'}


