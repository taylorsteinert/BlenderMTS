def register():
    bpy.utils.register_class(MuscleTissueSimulator_PT_Muscle_Tissue_Simulator)
    
    bpy.utils.register_class(PlayAnimationOperator)
    bpy.utils.register_class(PauseAnimationOperator)
    
    bpy.utils.register_class(MuscleTissueSimulator_PT_Muscle_Physics)
    
    bpy.utils.register_class(EnablePhysicsOperator)
    bpy.utils.register_class(DisablePhysicsOperator)
    bpy.utils.register_class(EnableCollisionOperator)
    bpy.utils.register_class(DisableCollisionOperator)    
    bpy.utils.register_class(EnableTriangulateMeshOperator)
    bpy.utils.register_class(DisableTriangulateMeshOperator)
    bpy.utils.register_class(EnableSubdivisionSurfaceOperator)
    bpy.utils.register_class(DisableSubdivisionSurfaceOperator)

    bpy.utils.register_class(MuscleTissueSimulator_Settings_PG)
    bpy.types.Object.settings_pg_props = bpy.props.PointerProperty(type=MuscleTissueSimulator_Settings_PG)

    bpy.utils.register_class(MuscleTissueSimulator_PT_MuscleConstraints)
    bpy.utils.register_class(VertexGroupMuscleEnds)
    bpy.utils.register_class(VertexGroupMusclePressure)
    bpy.utils.register_class(VertexGroupMuscleBending)
    bpy.utils.register_class(VertexGroupMuscleShrinkage)
        
    bpy.utils.register_class(MuscleTissueSimulator_PT_visual_settings)

    bpy.utils.register_class(MuscleTissueSimulator_Help)

def unregister():
    bpy.utils.unregister_class(MuscleTissueSimulator_PT_Muscle_Tissue_Simulator)
    
    bpy.utils.unregister_class(PlayAnimationOperator)
    bpy.utils.unregister_class(PauseAnimationOperator)
    
    bpy.utils.unregister_class(MuscleTissueSimulator_PT_Muscle_Physics)
    
    bpy.utils.unregister_class(EnablePhysicsOperator)
    bpy.utils.unregister_class(DisablePhysicsOperator)
    bpy.utils.unregister_class(EnableCollisionOperator)
