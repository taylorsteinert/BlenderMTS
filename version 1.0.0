class EnableTriangulateMeshOperator(bpy.types.Operator):
    """Adds a triangulate modifier to selected mesh objects"""
    bl_idname = "object.add_triangulate_modifier"
    bl_label = "Triangulate Mesh"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        for obj in context.selected_objects:
            if obj.type == 'MESH':
                if not any(mod.type == 'TRIANGULATE' for mod in obj.modifiers):
                    obj.modifiers.new(name="Triangulate", type='TRIANGULATE')
                    self.report({'INFO'}, f"Triangulate modifier added to {obj.name}")
                else:
                    self.report({'WARNING'}, f"{obj.name} already has a triangulate modifier")
            else:
                self.report({'WARNING'}, f"{obj.name} is not a mesh object")
        return {'FINISHED'}

