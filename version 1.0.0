class MuscleTissueSimulator_Settings_PG(bpy.types.PropertyGroup):
    def update_modifier(self, context):
        
        # Checks for presence of cloth modifier and applies changes from add-on to it
        cloth = context.object.modifiers.get("Cloth")
        if cloth:
            cloth.settings.mass = self.cloth_mass
            cloth.settings.air_damping = self.air_damping
            cloth.settings.tension_stiffness = self.tension_stiffness
            cloth.settings.compression_stiffness = self.compression_stiffness
            cloth.settings.tension_damping = self.tension_damping
            cloth.settings.compression_damping = self.compression_damping
            cloth.settings.bending_stiffness = self.bending_stiffness
    
    cloth_mass: FloatProperty(
        name = "Muscle Mass (kg/vertex)",
        default= 0.3,
        min = 0.1,
        max = 50.0,
        soft_max = 10.0,
        description = "The mass of each vertex on the muscle.",
        update = update_modifier
    )
    
    air_damping: FloatProperty(
        name ="Air viscosity",
        default = 1.0,
        min = 0.1,
        soft_max = 1.0,
        max = 20.0,
        description = "Air thickness that slows falling objects down.",
        update = update_modifier
    )
    
    tension_stiffness: FloatProperty(
        name = "Tension",
        default = 5.0,
        min = 1.0,
        max = 50.0,
        soft_max = 20.0,
        description = "Object stretching resistence.",
        update = update_modifier
    )
    
    compression_stiffness: FloatProperty(
        name = "Compression",
        default = 5.0,
        min = 1.0,
        max = 50.0,
        soft_max = 20.0,
        description = "Object compression resistence.",
        update = update_modifier
    )
    
    tension_damping: FloatProperty(
        name = "Tension",
        default = 5.0,
        min = 1.0,
        max = 50.0,
        soft_max = 20.0,
        description = "Amount of damping in stretching behavior.",
        update = update_modifier
    )
    
    compression_damping: FloatProperty(
        name = "Compression",
        default = 5.0,
        max = 50.0,
        soft_max = 20.0,
        description = "Amount of damping in compression behavior.",
        update = update_modifier
    )
    
    bending_stiffness: FloatProperty(
        name = "Bending Stiffness",
        default = 0.5,
        min = 0.0,
        soft_max = 1.0,
        max = 2.0,
        description = "Amount of resistance to bending.",
        update = update_modifier        
    )
    
    bending_damping: FloatProperty(
        name = "Bending Damping",
        default = 0.5,
        min = 0.0,
        soft_max = 1.0,
        max = 2.0,
        description = "Amount of damping in bending behavior.",
        update = update_modifier
    )
    
    shrink_min: FloatProperty(
        name = "Shrinking Factor",
        default = 0.0,
        min = -1.0,
        max = 1.0,
        description = "Factor by which to shrink muscle.",
        update = update_modifier
    )
    
    
class MuscleTissueSimulator_PT_Muscle_Tissue_Simulator(bpy.types.Panel):
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "MTS"
    bl_label = "Muscle Tissue Simulator" # Panel label/name

    def draw_header_preset(self, context):
        layout = self.layout
        layout.label(text="", icon="RENDER_ANIMATION")


    def draw(self, context):
        layout = self.layout
        
        """Timeline / Playback settings"""
        
        layout.label(text="Simulation Timeline Controls")
        
        # Create black box and horizontal row inside it
        box = layout.box()  # bordered box with black background
        row = box.row()  # horizontal row inside the box

        # First column (Play button)
        col = row.column()
        col.operator("screen.custom_play_animation", text="Play", icon='PLAY')

        # Second column (Pause button)
        col = row.column()
        col.operator("screen.custom_pause_animation", text="Pause", icon='PAUSE')

        # Third column (Reset button)
        col = row.column()
        col.operator("screen.frame_jump", text="", icon='FILE_REFRESH').end = False


class MuscleTissueSimulator_PT_Muscle_Physics(bpy.types.Panel):
    
    """Creates buttons and access to important functions from cloth physics to simulate muscles"""
    
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "MTS"
    bl_label = "Muscle Physics"
    bl_idname = "MTS_PT_tissue_settings"
        
    def draw_header_preset(self, context):
        layout = self.layout
        layout.label(text="", icon="PHYSICS")


    def draw(self, context):
        layout = self.layout
        col = layout.column()
        
        obj = context.object
        
        props = obj.settings_pg_props
        
        """Tissue Physics & Constraints"""
        """Physics"""
        
        # If no objects selected
        if len(context.selected_objects) == 0:
            row = col.row()
            row.label(text = "No objects selected")
            return

        layout.label(text="Physics")

        # Physics modifier => Cloth modifier
        box = layout.box()
        row = box.row()
        row.label(text = "Physics: ")
        row.alert = True
        col = row.column()
        col.operator("object.enable_cloth_physics", text="Enable", icon = 'CHECKMARK')
        row.alert = False
        col = row.column()
        col.operator("object.disable_cloth_physics", text="Remove", icon = 'CANCEL')


        # Triangulate modifier 
        box = layout.box()
        row = box.row()
        row.label(text = "Triangulate: ")
        col = row.column()
        col.operator("object.add_triangulate_modifier", text="Enable", icon = 'CHECKMARK')
        col = row.column()
        col.operator("object.disable_triangulate_modifier", text="Remove", icon = 'CANCEL')
        
        # Physics modifier => Collision modifier        
        box = layout.box()
        row = box.row()    
        row.label(text = "Collision Object: ")
        col = row.column()
        col.operator("object.enable_collision_physics", text="Enable", icon = 'CHECKMARK')
        col = row.column()
        col.operator("object.disable_collision_physics", text="Remove", icon = 'CANCEL')

        # => Cloth Modifier Settings
        cloth_mod = next((mod for mod in obj.modifiers if mod.type == 'CLOTH'), None)
        if cloth_mod:
            
            cloth_settings = cloth_mod.settings
            collision_settings = cloth_mod.collision_settings

            layout.prop(cloth_settings, "quality", text="Simulation Quality", slider=True)
            layout.prop(collision_settings, "collision_quality", text="Collision Quality", slider=True)
            layout.prop(collision_settings, "use_self_collisions", text = "Self Collision", toggle = True)
            
            # Separator
            row = layout.row()
            row.label(text="") 
            
            """Physical Properties"""
           
            # Pulls data from MuscleTissueSimulator_Settings_PG Property Group
            layout.label(text = "Physical Properties")
            layout.prop(props, "cloth_mass", slider=True)
            layout.prop(props, "air_damping", slider = True)
            
            layout.label(text = "Stiffness")
            layout.prop(props, "tension_stiffness", slider = True)
            layout.prop(props, "compression_stiffness", slider = True)
            layout.prop(props, "bending_stiffness", slider = True)
            
            
            layout.label(text = "Damping")            
            layout.prop(props, "tension_damping", slider = True)
            layout.prop(props, "compression_damping", slider = True)        
            layout.prop(props, "bending_damping", slider = True)
                                    
            layout.label(text = "Optional")
            
            layout.prop(cloth_settings, "use_internal_springs", text = "Internal Springs", toggle = True)
            layout.prop(cloth_settings, "use_pressure", text = "Pressure", toggle = True)
            layout.prop(collision_settings, "use_self_collision", text = "Self Collisions", toggle = True)
            


class MuscleTissueSimulator_PT_MuscleConstraints(bpy.types.Panel):
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "MTS"
    bl_label = "Muscle Constraints"
    bl_idname = "MTS_PT_muscle_attachment"
    

    def draw_header_preset(self, context):
        layout = self.layout
        layout.label(text="", icon="GROUP_VERTEX")

    def draw(self, context):
        
        layout = self.layout
        col = layout.column()
        
        """Check for selected Object"""
        
        # If no objects selected
        if len(context.selected_objects) == 0:
            row = col.row()
            row.label(text = "No objects selected")
            return
        
        """Vertex Groups"""
        layout.label(text="Weight paint bounds for -Physical Properties-")        

        box = layout.box()
        row = box.row()

        row.alert = True
        # Creates vertex group for Muscle Ends
        col = row.column()
        col.operator("object.define_muscle_ends", text = "Muscle Ends")
        
        row.alert = False
        # Creates vertex group for Muscle Weight
        col = row.column()
        col.operator("object.define_muscle_pressure", text = "Muscle Pressure")
        
        row = box.row()
        
        # Creates vertex group for Muscle Bending Stiffness
        col = row.column()
        col.operator("object.define_muscle_bending", text = "Muscle Bending Stiffness")
        
        # Creates vertex group for Muscle Bending Stiffness
        col = row.column()
        col.operator("object.define_muscle_shrinkage", text = "Muscle Shrinkage")
        

        
class MuscleTissueSimulator_PT_visual_settings(bpy.types.Panel):
    
    """Creates fast access to Subdivision Surface Modifier and different Shading options for object(s)"""
    
    bl_space_type = "VIEW_3D"
    bl_region_type = "UI"
    bl_category = "MTS"
    bl_label = "Visual Settings"
    bl_idname = "MTS_PT_visual_settings"
    

    def draw_header_preset(self, context):
        layout = self.layout
        layout.label(text="", icon="MOD_SUBSURF")


    def draw(self, context):
        
        layout = self.layout
        col = layout.column()
        
        # If no objects selected
        if len(context.selected_objects) == 0:
            row = col.row()
            row.label(text = "No objects selected")
            return 
        
        """Visual Settings"""
        """Subsurface Scattering Modifier"""
        
        layout.label(text="Subdivision Surface")
        box = layout.box()
        row = box.row()

        col = row.column()
        col.operator("object.add_subdivisionsurface_modifier", text="Enable", icon = 'CHECKMARK')
        col = row.column()
        col.operator("object.disable_subdivisionsurface_modifier", text="Remove", icon = 'CANCEL')
        
        
        """Object Shading Options"""
        
        layout.label(text="Object Shading Options")

        box = layout.box()
        row = box.row()

        # Smooth shading
        col = row.column()
        col.operator("object.shade_smooth", text="Smooth")
        
        # Auto smooth shading
        col = row.column()
        col.operator("object.shade_auto_smooth", text="Auto")
        
        # Flat shading
        col = row.column()
        col.operator("object.shade_flat", text="Flat")



