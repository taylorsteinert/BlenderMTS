    """Adds a collision modifier to the selected object(s)"""
    bl_idname = "object.enable_collision_physics"
    bl_label = "Enable Collision Physics"
    bl_options = {'REGISTER', 'UNDO'}

    def execute(self, context):
        for obj in context.selected_objects:
            if obj.type == 'MESH':
                # Check if cloth modifier already exists
                if not any(mod.type == 'COLLISION' for mod in obj.modifiers):
                    obj.modifiers.new(name="Collision", type='COLLISION')
                    self.report({'INFO'}, f"Collision modifier added to {obj.name}")
                else:
